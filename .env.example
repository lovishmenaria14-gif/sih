# GEMINI_API_KEY: Required for Gemini multimodal vision extraction.
# Automatically managed via Settings > Secrets in Google AI Studio.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# MONGODB_URI: (Optional) MongoDB connection string for production persistence.
# If not provided, the application uses local structured file repository automatically.
MONGODB_URI=

# VITE_GOOGLE_MAPS_API_KEY: (Optional) Google Maps Platform API Key for live Google Maps tiles & Deck.gl Heatmap.
# For quick prototyping, obtain a free Maps Demo Key from Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY=
